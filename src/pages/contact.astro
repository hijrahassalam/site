---
import BaseLayout from '../layouts/BaseLayout.astro';
import PixelWindow from '../components/PixelWindow.astro';
import PixelButton from '../components/PixelButton.astro';

// Kalau ID Formspree diisi lewat env, form akan mengirim ke sana.
// Kalau kosong, form tidak berpura-pura berhasil: pesan dibuka di aplikasi email pengunjung.
const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID ?? '';
const endpoint = formspreeId ? `https://formspree.io/f/${formspreeId}` : '';

const direct = [
  { label: 'Email', value: 'hello@hijrahassalam.com', href: 'mailto:hello@hijrahassalam.com' },
  { label: 'GitHub', value: 'github.com/hijrahassalam', href: 'https://github.com/hijrahassalam' },
  { label: 'LinkedIn', value: 'linkedin.com/in/hijrahassalam', href: 'https://linkedin.com/in/hijrahassalam' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact — Hijrah Assalam',
  url: 'https://www.hijrahassalam.com/contact',
};
---

<BaseLayout
  title="Contact — Hijrah Assalam"
  description="Get in touch with Hijrah Assalam for remote roles, product collaborations, or research conversations."
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-6xl px-4 pb-4 pt-12 sm:px-6 sm:pt-16">
    <div class="reveal">
      <p class="eyebrow">Communication terminal</p>
      <h1 class="mt-4 text-[2rem] font-semibold leading-tight tracking-tight text-ink sm:text-4xl">
        Send a message
      </h1>
      <p class="mt-4 max-w-2xl text-[1.0625rem] leading-relaxed text-ink-2">
        Tell me what you're building, the role you're hiring for, or the research question you're
        working on. I reply to everything that isn't automated outreach.
      </p>
    </div>
  </section>

  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-8 lg:grid-cols-[1.2fr_0.8fr] lg:gap-14 sm:px-6">
    <div class="reveal">
      <PixelWindow title="Message form" accent="cyan">
        <form
          id="contact-form"
          class="space-y-4"
          data-endpoint={endpoint}
          data-email="hello@hijrahassalam.com"
        >
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="name" class="hud-label">Name</label>
              <input
                id="name"
                name="name"
                type="text"
                required
                autocomplete="name"
                class="mt-2 min-h-[44px] w-full rounded-[2px] border border-ink/15 bg-bg-base px-3 py-2.5 text-sm text-ink placeholder:text-ink-3 focus:border-cyan-400 focus:outline-none"
                placeholder="Your name"
              />
            </div>
            <div>
              <label for="email" class="hud-label">Email</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                class="mt-2 min-h-[44px] w-full rounded-[2px] border border-ink/15 bg-bg-base px-3 py-2.5 text-sm text-ink placeholder:text-ink-3 focus:border-cyan-400 focus:outline-none"
                placeholder="you@company.com"
              />
            </div>
          </div>

          <div>
            <label for="subject" class="hud-label">Subject</label>
            <input
              id="subject"
              name="subject"
              type="text"
              required
              class="mt-2 min-h-[44px] w-full rounded-[2px] border border-ink/15 bg-bg-base px-3 py-2.5 text-sm text-ink placeholder:text-ink-3 focus:border-cyan-400 focus:outline-none"
              placeholder="Remote role · Collaboration · Research"
            />
          </div>

          <div>
            <label for="message" class="hud-label">Message</label>
            <textarea
              id="message"
              name="message"
              required
              rows="6"
              class="mt-2 w-full rounded-[2px] border border-ink/15 bg-bg-base px-3 py-2.5 text-sm text-ink placeholder:text-ink-3 focus:border-cyan-400 focus:outline-none"
              placeholder="Context, scope, timeline — anything that helps me answer properly."
            ></textarea>
          </div>

          <div class="flex flex-wrap items-center gap-4 pt-1">
            <button type="submit" class="btn btn-primary">Send message</button>
            <p class="hud-label text-ink-3">Usually replies within 1–2 days</p>
          </div>

          <p
            id="form-status"
            role="status"
            aria-live="polite"
            class="hidden border-l-2 px-4 py-3 text-sm"
          >
          </p>
        </form>
      </PixelWindow>
    </div>

    <aside class="reveal h-fit">
      <div class="panel p-5">
        <h2 class="hud-label">Direct channels</h2>
        <ul class="mt-4 space-y-3.5">
          {
            direct.map((item) => (
              <li>
                <p class="hud-label text-ink-3">{item.label}</p>
                <a
                  href={item.href}
                  class="hud-value mt-1.5 block text-cyan-400 hover:text-cyan-glow"
                  {...item.href.startsWith('http')
                    ? { target: '_blank', rel: 'noopener noreferrer' }
                    : {}}
                >
                  {item.value}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="panel mt-4 p-5">
        <h2 class="hud-label">What to include</h2>
        <ul class="mt-4 space-y-2.5 text-sm leading-relaxed text-ink-2">
          <li>— The problem or role in one sentence</li>
          <li>— Stack and constraints, if technical</li>
          <li>— Timeline and timezone overlap</li>
          <li>— For research: the question, not the pitch</li>
        </ul>
      </div>

      <div class="panel mt-4 p-5">
        <h2 class="hud-label">Availability</h2>
        <p class="mt-3 flex items-center gap-2 text-sm text-ink-2">
          <span class="dot dot-live" aria-hidden="true"></span>
          Open to remote work · GMT+7
        </p>
        <div class="mt-4">
          <PixelButton href="/hire" variant="ghost">See recruiter summary</PixelButton>
        </div>
      </div>
    </aside>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');

  const show = (message: string, tone: 'ok' | 'warn' | 'error') => {
    if (!status) return;
    status.textContent = message;
    status.classList.remove('hidden', 'border-mint-400/45', 'bg-mint-400/10', 'text-ink-2',
      'border-amber-400/45', 'bg-amber-400/10', 'border-red-400/50', 'bg-red-400/10');
    const tones = {
      ok: ['border-mint-400/45', 'bg-mint-400/10', 'text-ink-2'],
      warn: ['border-amber-400/45', 'bg-amber-400/10', 'text-ink-2'],
      error: ['border-red-400/50', 'bg-red-400/10', 'text-ink-2'],
    };
    status.classList.add(...tones[tone]);
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    const data = new FormData(form);
    const name = String(data.get('name') ?? '').trim();
    const email = String(data.get('email') ?? '').trim();
    const subject = String(data.get('subject') ?? '').trim();
    const message = String(data.get('message') ?? '').trim();
    const endpoint = form.dataset.endpoint ?? '';
    const fallbackEmail = form.dataset.email ?? '';

    if (endpoint) {
      const button = form.querySelector('button[type="submit"]');
      if (button instanceof HTMLButtonElement) {
        button.disabled = true;
        button.textContent = 'Sending…';
      }
      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: data,
        });
        if (response.ok) {
          form.reset();
          show('Message sent. Hijrah received your message — expect a reply within 1–2 days.', 'ok');
        } else {
          show('The form endpoint rejected the message. Please email hello@hijrahassalam.com directly.', 'error');
        }
      } catch {
        show('Could not reach the form service. Please email hello@hijrahassalam.com directly.', 'error');
      } finally {
        if (button instanceof HTMLButtonElement) {
          button.disabled = false;
          button.textContent = 'Send message';
        }
      }
      return;
    }

    // Fallback jujur: tidak ada endpoint terpasang → buka aplikasi email pengunjung dengan isi pesan.
    const body = `${message}\n\n—\n${name}\n${email}`;
    const mailto = `mailto:${fallbackEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    window.location.href = mailto;
    show(
      'This form is not connected to a mail service yet, so your message was opened in your email app instead — nothing is lost. You can also email hello@hijrahassalam.com directly.',
      'warn'
    );
  });
</script>
