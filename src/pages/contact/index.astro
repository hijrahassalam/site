---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { site } from '../../data/profile';

const topics = ['Full-time role', 'Contract / freelance', 'AI product collaboration', 'Speaking or workshop', 'Research collaboration', 'Something else'];

const field =
  'mt-2 block w-full rounded-md border border-line-strong bg-surface px-4 py-3 text-ink placeholder:text-muted focus:border-ink focus:outline-none focus-visible:outline-2 focus-visible:outline-gold';
const label = 'text-[0.7rem] font-bold tracking-[0.16em] text-ink-soft uppercase';
const formEnabled = site.web3formsKey.length > 0;
const thanksUrl = new URL('/contact/thanks/', Astro.site).toString();
---

<BaseLayout title="Contact" description="Get in touch with Hijrah Assalam about roles, contracts, AI product collaborations or speaking.">
  <PageHeader
    eyebrow="Contact"
    title="Let's talk."
    intro="A role, a project, a workshop, or just a question about building AI products: send a note. I read every message and reply personally."
  />

  <section>
    <div class="mx-auto grid max-w-6xl gap-14 px-4 py-16 sm:px-6 md:grid-cols-[1.5fr_1fr] md:gap-20 md:py-24">
      {formEnabled ? (
      <form method="POST" action="https://api.web3forms.com/submit" class="space-y-6" data-contact-form>
        <input type="hidden" name="access_key" value={site.web3formsKey} />
        <input type="hidden" name="subject" value="New message from hijrahassalam.com" />
        <input type="hidden" name="from_name" value="hijrahassalam.com" />
        <input type="hidden" name="redirect" value={thanksUrl} />
        <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

        <div class="grid gap-6 sm:grid-cols-2">
          <label class="block">
            <span class={label}>Name</span>
            <input class={field} type="text" name="name" autocomplete="name" required />
          </label>
          <label class="block">
            <span class={label}>Email</span>
            <input class={field} type="email" name="email" autocomplete="email" required />
          </label>
        </div>

        <label class="block">
          <span class={label}>Company <span class="font-medium tracking-normal normal-case text-muted">(optional)</span></span>
          <input class={field} type="text" name="company" autocomplete="organization" />
        </label>

        <fieldset>
          <legend class={label}>What's it about?</legend>
          <div class="mt-3 flex flex-wrap gap-2">
            {
              topics.map((t, i) => (
                <label class="cursor-pointer">
                  <input type="radio" name="topic" value={t} class="peer sr-only" required={i === 0} checked={i === 0} />
                  <span class="inline-block rounded-full border border-line-strong px-4 py-2 text-sm font-semibold text-ink-soft transition peer-checked:border-ink peer-checked:bg-ink peer-checked:text-paper peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-gold hover:border-ink">
                    {t}
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <label class="block">
          <span class={label}>Message</span>
          <textarea class={`${field} min-h-44 resize-y`} name="message" required placeholder="A few lines about the role or project, the team, and the timeline."></textarea>
        </label>

        <div class="flex flex-wrap items-center gap-4">
          <button type="submit" class="inline-flex cursor-pointer items-center gap-2 rounded-md bg-ink px-6 py-3.5 font-semibold text-paper transition hover:opacity-90 disabled:cursor-wait disabled:opacity-60">
            <span data-label>Send message</span> <span aria-hidden="true">→</span>
          </button>
          <p data-status role="status" aria-live="polite" class="text-sm text-ink-soft"></p>
        </div>
      </form>
      ) : (
      <div class="border border-line bg-surface p-8">
        <p class="text-xl font-bold tracking-tight">The quickest way to reach me is email.</p>
        <p class="mt-3 leading-relaxed text-ink-soft">
          Tell me a little about the role or project, the team and the timeline.
        </p>
        <a href={`mailto:${site.email}`} class="mt-6 inline-flex items-center gap-2 rounded-md bg-ink px-6 py-3.5 font-semibold text-paper transition hover:opacity-90">
          Email {site.email} <span aria-hidden="true">→</span>
        </a>
      </div>
      )}

      <aside class="space-y-10">
        <div>
          <p class="eyebrow">Direct</p>
          <ul class="mt-5 border-t border-line">
            <li class="border-b border-line">
              <a href={`mailto:${site.email}`} class="flex items-center justify-between py-4 font-semibold hover:text-gold-ink">
                {site.email} <span aria-hidden="true">→</span>
              </a>
            </li>
            <li class="border-b border-line">
              <a href={site.links.linkedin} class="flex items-center justify-between py-4 font-semibold hover:text-gold-ink">
                LinkedIn <span aria-hidden="true">↗</span>
              </a>
            </li>
            <li class="border-b border-line">
              <a href={site.links.github} class="flex items-center justify-between py-4 font-semibold hover:text-gold-ink">
                GitHub <span aria-hidden="true">↗</span>
              </a>
            </li>
          </ul>
        </div>
        <div>
          <p class="eyebrow">Availability</p>
          <ul class="mt-5 space-y-3 text-ink-soft">
            <li>Open to remote and hybrid roles</li>
            <li>GMT+7, with async-first collaboration</li>
            <li>English C1 Advanced</li>
            <li>B2B invoice, PayPal or Payoneer</li>
          </ul>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  // Submit in the background so visitors stay on the site, then show our own thank-you page.
  // Without JavaScript the form still posts directly to Web3Forms.
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const label = form.querySelector<HTMLElement>('[data-label]')!;
    const status = form.querySelector<HTMLElement>('[data-status]')!;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      button.disabled = true;
      label.textContent = 'Sending…';
      status.textContent = '';

      const data = new FormData(form);
      data.delete('redirect');

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: data,
        });
        const json = await res.json().catch(() => ({}));
        if (!res.ok || json.success === false) throw new Error(json.message || 'Request failed');
        window.location.assign('/contact/thanks/');
      } catch {
        button.disabled = false;
        label.textContent = 'Send message';
        status.innerHTML =
          'Sorry, that didn’t go through. Please try again or email <a class="font-semibold text-ink underline decoration-gold decoration-2 underline-offset-4" href="mailto:hijrahassalam@gmail.com">hijrahassalam@gmail.com</a>.';
      }
    });
  }
</script>
