---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PixelBadge from '../../components/PixelBadge.astro';
import ProjectPreview from '../../components/ProjectPreview.astro';
import PixelButton from '../../components/PixelButton.astro';
import { accents, statusLabels } from '../../lib/accent';

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects');
  return projects
    .filter((project) => project.data.hasDetail)
    .map((project) => ({ params: { slug: project.id }, props: { project } }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content } = await render(project);

const data = project.data;
const a = accents[data.accent];
const statusLabel = statusLabels[data.statusKind] ?? data.status;

const categoryLabel =
  data.category === 'current'
    ? 'Current build'
    : data.category === 'production'
      ? 'Production system'
      : 'Tooling';

const external = (data.links ?? []).find((link) => link.href.startsWith('http'));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: data.title,
  description: data.positioning,
  url: `https://www.hijrahassalam.com/work/${project.id}`,
  author: { '@type': 'Person', name: 'Hijrah Assalam' },
  keywords: (data.stack ?? []).map((group) => group.items).join(', '),
};
---

<BaseLayout title={`${data.title} — Hijrah Assalam`} description={data.positioning} jsonLd={jsonLd}>
  <article class="mx-auto max-w-5xl px-4 pt-10 sm:px-6 sm:pt-14">
    <!-- Breadcrumb -->
    <nav class="hud-label flex items-center gap-2 text-ink-3" aria-label="Breadcrumb">
      <a href="/work" class="hover:text-cyan-400">Work</a>
      <span aria-hidden="true">/</span>
      <span class="text-ink-2">{data.title}</span>
    </nav>

    <!-- Header -->
    <header class="reveal mt-8">
      <p class:list={['eyebrow', a.text]}>{categoryLabel}</p>
      <h1 class="mt-4 text-[2rem] font-semibold leading-tight tracking-tight text-ink sm:text-4xl">
        {data.title}
      </h1>
      <p class="mt-4 max-w-2xl text-[1.0625rem] leading-relaxed text-ink-2">{data.positioning}</p>

      <div class="mt-6 flex flex-wrap items-center gap-2">
        <PixelBadge label={statusLabel} accent={data.accent} pulse />
        <PixelBadge label={data.role} accent="cyan" />
        {data.scale && <PixelBadge label={data.scale} accent="mint" />}
        {data.period && <span class="hud-label text-ink-3">{data.period}</span>}
      </div>

      {external && (
        <div class="mt-7">
          <PixelButton href={external.href}>{external.label}</PixelButton>
        </div>
      )}
    </header>

    <!-- Visual: real workflow (§26–§28) -->
    {
      data.flow && data.flow.length > 0 && (
        <section class="reveal mt-10">
          <p class="hud-label mb-3">{data.flowLabel ?? 'Flow'}</p>
          <ProjectPreview
            flow={data.flow}
            accent={data.accent}
            direction="horizontal"
            caption={`${data.title} — workflow summary`}
          />
        </section>
      )
    }

    <!-- Metrics -->
    {
      data.metrics && data.metrics.length > 0 && (
        <section class="reveal mt-10">
          <dl class="grid grid-cols-2 gap-4 border-y border-ink/10 py-6 sm:grid-cols-3">
            {data.metrics.map((metric) => (
              <div>
                <dd class:list={['hud-value text-lg', a.text]}>{metric.value}</dd>
                <dt class="hud-label mt-1.5 text-ink-3">{metric.label}</dt>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    <div class="mt-12 grid gap-10 lg:grid-cols-[1.35fr_0.65fr] lg:gap-14">
      <!-- Body -->
      <div class="reveal">
        <div
          class="max-w-none text-[0.9375rem] leading-relaxed text-ink-2 [&>p+p]:mt-5 [&>p:first-child]:text-ink"
        >
          <Content />
        </div>

        {
          data.highlights && data.highlights.length > 0 && (
            <section class="mt-10">
              <h2 class="hud-label">What it does</h2>
              <ul class="mt-4 space-y-3">
                {data.highlights.map((highlight) => (
                  <li class="flex gap-3 text-[0.9375rem] leading-relaxed text-ink-2">
                    <span class:list={['mt-[8px] h-1.5 w-1.5 flex-none', a.bg]} aria-hidden="true" />
                    <span>{highlight}</span>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>

      <!-- Sidebar: stack berkelompok (§42) -->
      <aside class="reveal h-fit">
        <div class="panel p-5">
          <h2 class="hud-label">Capabilities</h2>
          <dl class="mt-4 space-y-4">
            {
              (data.stack ?? []).map((group) => (
                <div>
                  <dt class="hud-label text-ink-3">{group.label}</dt>
                  <dd class="hud-value mt-1.5 text-ink-2">{group.items}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        <div class="panel mt-4 p-5">
          <h2 class="hud-label">Status</h2>
          <p class="mt-3 flex items-center gap-2 text-sm text-ink-2">
            <span class:list={['dot', a.dot]} aria-hidden="true"></span>
            {data.status}
          </p>
          <p class="hud-label mt-3 text-ink-3">Role · {data.role}</p>
        </div>
      </aside>
    </div>

    <!-- Footer nav -->
    <div class="reveal mt-14 flex flex-wrap items-center gap-3 border-t border-ink/10 pt-8">
      <PixelButton href="/work" variant="ghost">All work</PixelButton>
      <PixelButton href="/contact" variant="ghost">Get in touch</PixelButton>
    </div>
  </article>
</BaseLayout>
