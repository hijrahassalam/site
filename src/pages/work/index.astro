---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const currentBuilds = projects.filter((p) => p.data.category === 'current');
const production = projects.filter((p) => p.data.category === 'production');
const tooling = projects.filter((p) => p.data.category === 'tooling');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Work — Hijrah Assalam',
  url: 'https://www.hijrahassalam.com/work',
  description:
    'Production systems, AI products, and enterprise platforms built by Hijrah Assalam.',
};
---

<BaseLayout
  title="Work — Hijrah Assalam"
  description="Current builds, production systems, and AI tooling — evidence of what Hijrah Assalam has shipped and operates."
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-6xl px-4 pb-6 pt-12 sm:px-6 sm:pt-16">
    <div class="reveal">
      <p class="eyebrow">Work</p>
      <h1 class="mt-4 text-[2rem] font-semibold leading-tight tracking-tight text-ink sm:text-4xl">
        What I've built and what I'm building
      </h1>
      <p class="mt-4 max-w-2xl text-[1.0625rem] leading-relaxed text-ink-2">
        Current builds come first, then the systems already running in production. Each entry states
        the role, the scale, and what it actually does — no decorative copy.
      </p>
    </div>
  </section>

  <!-- CURRENT BUILDS (§25) -->
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <SectionHeader eyebrow="Current builds" title="Actively building" accent="mint" />
    <div class="mt-8 space-y-6">
      {
        currentBuilds.map((project) => (
          <div class="reveal">
            <ProjectCard project={project.data} slug={project.id} variant="feature" />
          </div>
        ))
      }
    </div>
  </section>

  <!-- PRODUCTION SYSTEMS -->
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <SectionHeader
      eyebrow="Production systems"
      title="Running in production"
      description="Enterprise and consumer platforms with real users, real load, and real consequences when they fail."
      accent="mint"
    />
    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        production.map((project) => (
          <article class="panel reveal flex flex-col justify-between p-5 sm:p-6">
            <div>
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="text-lg font-semibold text-ink">{project.data.title}</h3>
                <span class="hud-label text-mint-400">{project.data.status}</span>
              </div>
              <p class="mt-2.5 text-[0.9375rem] leading-relaxed text-ink-2">
                {project.data.positioning}
              </p>

              {(project.data.metrics ?? []).length > 0 && (
                <dl class="mt-5 grid grid-cols-3 gap-3 border-t border-ink/10 pt-4">
                  {(project.data.metrics ?? []).slice(0, 3).map((metric) => (
                    <div>
                      <dd class="hud-value text-mint-400">{metric.value}</dd>
                      <dt class="hud-label mt-1 text-ink-3">{metric.label}</dt>
                    </div>
                  ))}
                </dl>
              )}
            </div>

            <div class="mt-5 flex items-center gap-4">
              {project.data.hasDetail && (
                <a href={`/work/${project.id}`} class="hud-label text-ink-2 hover:text-cyan-400">
                  Detail &#8594;
                </a>
              )}
              {(project.data.links ?? [])
                .filter((link) => link.href.startsWith('http'))
                .map((link) => (
                  <a
                    href={link.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hud-label text-ink-3 hover:text-ink"
                  >
                    {link.label} &#8599;
                  </a>
                ))}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- TOOLING -->
  {
    tooling.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
        <SectionHeader
          eyebrow="Tooling"
          title="AI engineering &amp; developer workflow"
          description="Internal capability rather than a public product — how the work itself gets done."
          accent="cyan"
        />
        <div class="mt-8 space-y-4">
          {tooling.map((project) => (
            <div class="reveal">
              <ProjectCard project={project.data} slug={project.id} variant="compact" />
            </div>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
