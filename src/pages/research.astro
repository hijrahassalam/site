---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PixelLabel from '../components/PixelLabel.astro';
import PixelButton from '../components/PixelButton.astro';
import ResearchFlow from '../components/ResearchFlow.astro';

const entries = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
const data = entries[0].data;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  name: data.title,
  alternativeHeadline: data.subtitle,
  author: { '@type': 'Person', name: 'Hijrah Assalam' },
  description: data.positioning,
  url: 'https://www.hijrahassalam.com/research',
  about: ['COVID-19 Detection', 'Grad-CAM', 'Explainable AI', 'Medical Imaging'],
};
---

<BaseLayout
  title="Research — Hijrah Assalam · Explainable AI for Healthcare"
  description="Three-class COVID-19 detection from chest X-ray with honest Grad-CAM analysis — including evidence of shortcut learning."
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-6xl px-4 pb-6 pt-12 sm:px-6 sm:pt-16">
    <PixelLabel label="Research path" accent="violet" cursor />
    <h1 class="mt-4 max-w-3xl text-[2rem] font-semibold leading-tight tracking-tight text-ink sm:text-4xl">
      {data.title}
    </h1>
    <p class="mt-4 text-lg text-violet-400">{data.subtitle}</p>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink-2">
      Grad-CAM is used as a diagnostic instrument: not only to explain a prediction, but to test whether the model learned the right thing.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
    <ResearchFlow
      pipeline={data.pipeline}
      metrics={data.metrics}
      comparison
      findingWarning={`${data.findingWarning} — evidence that dataset artifacts may influence predictions.`}
    />
    <p class="coord mt-3">Schematic diagrams — not patient images</p>
  </section>

  <!-- Finding led by comparison, not essay -->
  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <div class="grid gap-8 lg:grid-cols-[1.3fr_0.7fr] lg:items-start">
      <div>
        <PixelLabel label="Key finding" accent="violet" />
        <h2 class="mt-3 text-xl font-semibold text-ink sm:text-2xl">{data.findingTitle}</h2>
        <p class="mt-4 max-w-2xl text-[0.9375rem] leading-relaxed text-ink-2">
          The most important result is not the accuracy score. Some COVID-19 predictions attend outside the lung region. Surfacing that limitation is part of the research contribution—not an inconvenient footnote.
        </p>
      </div>

      <aside class="border-l-2 border-violet-400/50 pl-5">
        <p class="hud-label text-violet-400">Reference</p>
        <p class="mt-2 text-sm leading-relaxed text-ink-2">{data.reference}</p>
        <p class="hud-label mt-5 text-ink-3">Direction · Biomedical AI</p>
      </aside>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <div class="flex flex-col gap-6 border-t border-ink/10 pt-8 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <PixelLabel label="Next objective" accent="violet" />
        <h2 class="mt-3 max-w-xl text-xl font-semibold text-ink sm:text-2xl">
          Graduate research on accountable biomedical AI.
        </h2>
      </div>
      <PixelButton href="/contact" variant="ghost">Research inquiry</PixelButton>
    </div>
  </section>
</BaseLayout>
