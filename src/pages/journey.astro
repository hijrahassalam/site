---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import JourneyMap from '../components/JourneyMap.astro';
import PixelButton from '../components/PixelButton.astro';
import PixelBadge from '../components/PixelBadge.astro';

const chapters = [
  {
    region: 'Region 01 — Foundation',
    accent: 'cyan' as const,
    eyebrow: 'Engineering',
    nodes: [
      {
        year: '2021',
        title: 'Software engineering',
        note: 'Building and shipping web systems end to end — where the habit of finishing things started.',
        state: 'done' as const,
      },
      {
        title: 'Full-stack development',
        note: 'Backend, frontend, and deployment handled in one loop. Ownership from schema to screen.',
        state: 'done' as const,
      },
      {
        title: 'Learn Quran — 4M+ users',
        note: 'First experience operating a service used by millions across four platforms.',
        state: 'done' as const,
      },
    ],
  },
  {
    region: 'Region 02 — Enterprise',
    accent: 'mint' as const,
    eyebrow: 'Production',
    nodes: [
      {
        title: 'Penugasan UNS',
        note: 'Institutional workflow at 3,500+ staff and 900+ units: approvals, e-signature, geolocation, payment.',
        state: 'done' as const,
      },
      {
        title: 'Integration discipline',
        note: 'Third-party systems assumed to fail, approval flows made idempotent, audit trails treated as mandatory.',
        state: 'done' as const,
      },
    ],
  },
  {
    region: 'Region 03 — AI products',
    accent: 'mint' as const,
    eyebrow: 'Products',
    nodes: [
      {
        title: 'BundaGizi',
        note: 'WhatsApp AI nutrition assistant with a 1,146-item Indonesian food knowledge base, run in production.',
        state: 'done' as const,
      },
      {
        year: '2026',
        title: 'AsistenDiet & BidikTender',
        note: 'Two products in parallel: consumer AI for nutrition goals, enterprise AI for tender readiness.',
        state: 'current' as const,
      },
    ],
  },
  {
    region: 'Region 04 — Research',
    accent: 'violet' as const,
    eyebrow: 'Research',
    nodes: [
      {
        title: 'Explainable AI for medical imaging',
        note: 'CNN with honest Grad-CAM analysis — surfacing shortcut learning instead of hiding it.',
        state: 'current' as const,
      },
      {
        title: 'Biomedical AI',
        note: 'The direction I am committing to: models that are accurate and accountable.',
        state: 'current' as const,
      },
    ],
  },
  {
    region: 'Next region',
    accent: 'amber' as const,
    eyebrow: 'Next',
    nodes: [
      {
        title: 'Graduate study',
        note: 'Preparing graduate research in biomedical AI, targeting Japan.',
        state: 'next' as const,
      },
    ],
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: 'Journey — Hijrah Assalam',
  url: 'https://www.hijrahassalam.com/journey',
  description:
    'Career progression from software engineering through enterprise systems and AI products to biomedical AI research.',
};
---

<BaseLayout
  title="Journey — Hijrah Assalam"
  description="From software engineering to enterprise systems to AI products — and the research direction that comes next."
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-6xl px-4 pb-4 pt-12 sm:px-6 sm:pt-16">
    <div class="reveal">
      <p class="eyebrow text-amber-400">Journey</p>
      <h1 class="mt-4 max-w-3xl text-[2rem] font-semibold leading-tight tracking-tight text-ink sm:text-4xl">
        An evolving career adventure, not a static CV
      </h1>
      <p class="mt-4 max-w-2xl text-[1.0625rem] leading-relaxed text-ink-2">
        Each region taught something the previous one could not. Enterprise systems taught me to
        build for failure. AI products taught me to ship under real user constraints. Research is
        where both have to hold up at once.
      </p>
      <div class="mt-6 flex flex-wrap gap-2">
        <PixelBadge label="Engineering" accent="cyan" />
        <PixelBadge label="Products" accent="mint" />
        <PixelBadge label="Research" accent="violet" />
        <PixelBadge label="Journey" accent="amber" />
      </div>
    </div>
  </section>

  {
    chapters.map((chapter, i) => (
      <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
        <SectionHeader
          eyebrow={chapter.eyebrow}
          title={chapter.region}
          accent={chapter.accent}
        />
        <div class="reveal mt-6 lg:pl-[3px]">
          <JourneyMap nodes={chapter.nodes} />
        </div>
        {i < chapters.length - 1 && <div class="mt-6 border-t border-ink/8" />}
      </section>
    ))
  }

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="panel reveal p-6 sm:p-8">
      <p class="hud-label">Current objective</p>
      <h2 class="mt-3 text-xl font-semibold text-ink sm:text-2xl">
        Build AI products that hold up — then take that standard into research.
      </h2>
      <p class="mt-3 max-w-2xl text-[0.9375rem] leading-relaxed text-ink-2">
        The long-term direction is biomedical AI: models that are not only accurate, but
        accountable. Everything before this point is preparation for it.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <PixelButton href="/research">See the research</PixelButton>
        <PixelButton href="/hire" variant="ghost">Hire me</PixelButton>
      </div>
    </div>
  </section>
</BaseLayout>
