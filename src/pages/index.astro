---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroScene from '../components/HeroScene.astro';
import PlayerHUD from '../components/PlayerHUD.astro';
import PixelLabel from '../components/PixelLabel.astro';
import QuestPanel from '../components/QuestPanel.astro';
import ProductionRecord from '../components/ProductionRecord.astro';
import JourneyWorldMap from '../components/JourneyWorldMap.astro';
import ResearchFlow from '../components/ResearchFlow.astro';
import SaveScreen from '../components/SaveScreen.astro';
import PixelButton from '../components/PixelButton.astro';

const projects = await getCollection('projects');
const byId = (id: string) => projects.find((p) => p.id === id)!;

const asistendiet = byId('asistendiet');
const bidiktender = byId('bidiktender');
const uns = byId('penugasan-uns');
const bundagizi = byId('bundagizi');
const learnQuran = byId('learn-quran');

const research = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order)[0];
const now = (await getCollection('now'))[0];

const journeyNodes = [
  {
    title: 'Software engineering',
    year: '2021+',
    note: 'Building and shipping web systems end to end.',
    state: 'done' as const,
    x: 70,
    y: 470,
  },
  {
    title: 'Full-stack systems',
    note: 'Backend, frontend, and deployment in one loop.',
    state: 'done' as const,
    x: 215,
    y: 385,
  },
  {
    title: 'Enterprise systems',
    note: '3,500+ staff, 900+ units, real audit trails.',
    state: 'done' as const,
    x: 360,
    y: 430,
  },
  {
    title: 'AI products',
    note: 'WhatsApp AI in production: BundaGizi.',
    state: 'done' as const,
    x: 505,
    y: 330,
  },
  {
    title: 'Applied AI',
    year: '2026',
    note: 'AsistenDiet and BidikTender, in parallel.',
    state: 'current' as const,
    x: 650,
    y: 250,
  },
  {
    title: 'Biomedical AI',
    note: 'Interpretability for medical imaging.',
    state: 'current' as const,
    x: 795,
    y: 160,
  },
  {
    title: 'Next region',
    year: 'Graduate study',
    note: 'Preparing graduate research in biomedical AI.',
    state: 'next' as const,
    x: 915,
    y: 78,
  },
];

const saveQuests = now.data.quests.map((quest) => ({
  title: quest.title,
  status: quest.status,
  accent: quest.accent,
  href: quest.href,
}));

const hudCells = [
  { label: 'Player', value: 'Hijrah Assalam', accent: 'cyan' as const },
  { label: 'Class', value: 'AI Builder', accent: 'cyan' as const },
  { label: 'XP', value: '5+ years', accent: 'cyan' as const },
  { label: 'Current area', value: 'AI Products', accent: 'mint' as const },
  { label: 'Builds', value: 'AsistenDiet · BidikTender', accent: 'mint' as const },
  { label: 'Research path', value: 'Biomedical AI', accent: 'violet' as const },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Hijrah Assalam',
    url: 'https://www.hijrahassalam.com',
    jobTitle: 'AI Builder & Full-Stack Engineer',
    email: 'mailto:hello@hijrahassalam.com',
    sameAs: ['https://github.com/hijrahassalam', 'https://linkedin.com/in/hijrahassalam'],
    knowsAbout: ['Applied AI', 'Full-Stack Engineering', 'Enterprise Systems', 'Explainable AI', 'Biomedical AI'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Hijrah Assalam',
    url: 'https://www.hijrahassalam.com',
  },
];
---

<BaseLayout
  title="Hijrah Assalam — AI Builder & Full-Stack Engineer"
  description="Hijrah Assalam builds production AI products and full-stack systems, with a growing research direction in biomedical AI."
  jsonLd={jsonLd}
>
  <!-- 1 · OPENING SCREEN -->
  <HeroScene />

  <div class="mx-auto max-w-6xl px-4 pb-14 sm:px-6">
    <PlayerHUD cells={hudCells} title="Status" class="reveal" />
  </div>

  <!-- 2 · SELECT YOUR QUEST -->
  <section id="quests" class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="reveal flex items-end justify-between gap-6">
      <div>
        <PixelLabel label="Active quests" accent="mint" cursor />
        <h2 class="mt-3 text-2xl font-semibold tracking-tight text-ink sm:text-4xl">
          Select your quest
        </h2>
      </div>
      <span class="coord hidden flex-none sm:block">02 / 06</span>
    </div>

    <div class="reveal mt-8 space-y-6">
      <QuestPanel
        index="Quest 01"
        title="AsistenDiet"
        statusKind={asistendiet.data.statusKind}
        status={asistendiet.data.status}
        accent="mint"
        positioning="Goal-aware nutrition tracking through conversation, not forms."
        capabilities={[
          'Meals analysed from photos',
          'Feedback follows the chosen goal',
          'WhatsApp and web on one source of truth',
        ]}
        visual="asistendiet"
        slug="asistendiet"
      />

      <QuestPanel
        index="Quest 02"
        title="BidikTender"
        statusKind={bidiktender.data.statusKind}
        status={bidiktender.data.status}
        accent="cyan"
        positioning="Tender requirements extracted, matched, and scored for readiness."
        capabilities={[
          'Requirements read from official documents',
          'Every clause tied to its fulfilment document',
          'Blockers shown before the deadline, not after',
        ]}
        visual="bidiktender"
        slug="bidiktender"
        side="right"
      />
    </div>
  </section>

  <!-- 3 · PRODUCTION RECORD -->
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="reveal flex items-end justify-between gap-6">
      <div>
        <PixelLabel label="Production record" accent="mint" cursor />
        <h2 class="mt-3 text-2xl font-semibold tracking-tight text-ink sm:text-4xl">
          Systems already running
        </h2>
      </div>
      <span class="coord hidden flex-none sm:block">03 / 06</span>
    </div>

    <div class="reveal mt-8">
      <ProductionRecord
        hub={{
          title: uns.data.title,
          note: uns.data.positioning,
          href: '/work/penugasan-uns',
          metrics: [
            { value: '3,500+', label: 'Staff' },
            { value: '900+', label: 'Units' },
            { value: 'Live', label: 'Status' },
          ],
        }}
        branches={[
          {
            title: learnQuran.data.title,
            note: learnQuran.data.positioning,
            href: '/work',
            metrics: [
              { value: '4M+', label: 'Users' },
              { value: '4', label: 'Platforms' },
            ],
          },
          {
            title: bundagizi.data.title,
            note: bundagizi.data.positioning,
            href: '/work/bundagizi',
            metrics: [
              { value: '1.146', label: 'Foods' },
              { value: 'WhatsApp', label: 'Interface' },
            ],
          },
        ]}
      />
    </div>
  </section>

  <!-- 4 · JOURNEY WORLD MAP -->
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="reveal flex items-end justify-between gap-6">
      <div>
        <PixelLabel label="Journey" accent="amber" cursor />
        <h2 class="mt-3 text-2xl font-semibold tracking-tight text-ink sm:text-4xl">
          The route so far
        </h2>
      </div>
      <span class="coord hidden flex-none sm:block">04 / 06</span>
    </div>

    <div class="reveal mt-8">
      <JourneyWorldMap nodes={journeyNodes} currentIndex={4} />
    </div>

    <div class="reveal mt-6 flex flex-wrap items-center justify-between gap-4">
      <p class="max-w-xl text-sm text-ink-2">
        Each region taught something the previous one could not. Research is where both have to
        hold up at once.
      </p>
      <a href="/journey" class="hud-label inline-flex min-h-6 items-center text-amber-400">Full map &#8594;</a>
    </div>
  </section>

  <!-- 5 · RESEARCH PATH -->
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="reveal flex items-end justify-between gap-6">
      <div>
        <PixelLabel label="Research path" accent="violet" cursor />
        <h2 class="mt-3 text-2xl font-semibold tracking-tight text-ink sm:text-4xl">
          The next region
        </h2>
      </div>
      <span class="coord hidden flex-none sm:block">05 / 06</span>
    </div>

    <p class="reveal mt-4 max-w-xl text-sm leading-relaxed text-ink-2">
      {research.data.subtitle} — Grad-CAM used as a diagnostic instrument, not decoration.
    </p>

    <div class="reveal mt-8">
      <ResearchFlow pipeline={research.data.pipeline} metrics={research.data.metrics} />
    </div>

    <div class="reveal mt-6">
      <a href="/research" class="hud-label inline-flex min-h-6 items-center text-violet-400">Full research &#8594;</a>
    </div>
  </section>

  <!-- 6 · SAVE FILE -->
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="reveal flex items-end justify-between gap-6">
      <div>
        <PixelLabel label="Quest log" accent="amber" cursor />
        <h2 class="mt-3 text-2xl font-semibold tracking-tight text-ink sm:text-4xl">Save file</h2>
      </div>
      <span class="coord hidden flex-none sm:block">06 / 06</span>
    </div>

    <div class="reveal mt-8">
      <SaveScreen
        quests={saveQuests}
        updated={now.data.updated}
        nextObjective={{
          title: 'Graduate study',
          note: 'Preparing graduate research in biomedical AI, targeting Japan.',
        }}
      />
    </div>
  </section>

  <!-- FINAL CTA — panel terminal (§35) -->
  <section class="mx-auto max-w-6xl px-4 py-12 pb-6 sm:px-6">
    <div class="panel reveal overflow-hidden">
      <div class="flex items-center gap-2 border-b border-ink/10 bg-bg-base/50 px-4 py-2.5">
        <span class="h-2 w-2 rounded-[1px] bg-ink/25" aria-hidden="true"></span>
        <span class="h-2 w-2 rounded-[1px] bg-ink/25" aria-hidden="true"></span>
        <span class="h-2 w-2 rounded-[1px] bg-ink/25" aria-hidden="true"></span>
        <span class="hud-label ml-2 text-ink-3">communication terminal</span>
      </div>

      <div class="p-5 sm:p-7">
        <p class="hud-value text-ink-2">
          <span class="text-cyan-400">$</span> contact --open
        </p>
        <h2 class="mt-4 max-w-xl text-xl font-semibold tracking-tight text-ink sm:text-2xl">
          Open to remote roles, product collaborations, and research conversations.
        </h2>
        <div class="mt-6 flex flex-wrap gap-3">
          <PixelButton href="/contact">Send message</PixelButton>
          <PixelButton href="/hire" variant="ghost">Hire me</PixelButton>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
