---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BatikSeal from '../components/BatikSeal.astro';
import TumpalBand from '../components/TumpalBand.astro';
import ProofRow from '../components/ProofRow.astro';
import profilePhoto from '../assets/profile.webp';
import gdgPhoto from '../assets/gdg-semarang-2026.jpg';
import { site, proof, experience, recognition, capabilities } from '../data/profile';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout>
  <!-- ───────────── Hero ───────────── -->
  <section class="kawung border-b border-line">
    <div class="mx-auto grid max-w-6xl gap-12 px-4 pt-16 pb-14 sm:px-6 md:grid-cols-[1fr_auto] md:items-center md:gap-16 md:pt-24 md:pb-20">
      <div>
        <p class="eyebrow rise">Applied AI Engineer · {site.location}</p>
        <h1 class="rise rise-2 mt-6 max-w-3xl text-[2.6rem] leading-[1.05] font-extrabold tracking-[-0.035em] text-balance sm:text-6xl lg:text-[4.25rem]">
          I build AI products people actually use.
        </h1>
        <p class="rise rise-3 mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft text-pretty">
          Founder of <a href="https://www.asistendiet.com/" class="font-semibold text-ink underline decoration-gold decoration-2 underline-offset-4">AsistenDiet</a>{' '}and{' '}<a href="https://www.bundagizi.com/" class="font-semibold text-ink underline decoration-gold decoration-2 underline-offset-4">BundaGizi</a>,
          and Senior Software Engineer at Universitas Sebelas Maret. I take AI from prompt to production:
          LLM workflows, guardrails and evaluation, and the backend that keeps them running.
        </p>
        <div class="rise rise-4 mt-9 flex flex-wrap items-center gap-3">
          <a href="#work" class="inline-flex items-center gap-2 rounded-md bg-ink px-5 py-3 text-sm font-semibold text-paper shadow-sm transition hover:opacity-90">
            See selected work
            <span aria-hidden="true">→</span>
          </a>
          <a href={site.cv} class="inline-flex items-center gap-2 rounded-md border border-line-strong bg-surface px-5 py-3 text-sm font-semibold transition hover:border-ink">
            Download CV
          </a>
        </div>
      </div>

      <figure class="rise rise-3 mx-auto w-full max-w-[18rem] md:mx-0">
        <div class="relative">
          <div class="absolute -inset-3 rounded-[2px] border border-line-strong" aria-hidden="true"></div>
          <div class="absolute -top-3 -right-3 h-[3px] w-1/3 bg-gold" aria-hidden="true"></div>
          <Image
            src={profilePhoto}
            alt={`Portrait of ${site.name}`}
            widths={[288, 500]}
            sizes="288px"
            loading="eager"
            class="relative aspect-square w-full bg-surface object-cover"
          />
          <BatikSeal class="absolute -bottom-10 -left-10 size-28 drop-shadow-sm sm:-left-12 sm:size-32" />
        </div>
        <figcaption class="mt-6 pl-20 text-sm sm:pl-22 leading-snug text-muted">
          <span class="block font-semibold text-ink">{site.legalName}</span>
          {site.location} · {site.timezone}
        </figcaption>
      </figure>
    </div>

    <!-- Proof row -->
    <ProofRow items={proof} />
  </section>

  <!-- ───────────── Selected work ───────────── -->
  <section id="work" class="scroll-mt-24 border-b border-line">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-28">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">Selected work</p>
          <h2 class="mt-4 text-3xl font-extrabold tracking-tight sm:text-4xl">Products and systems I've built</h2>
        </div>
        <a href={site.links.github} class="text-sm font-semibold text-ink-soft hover:text-ink">
          All repositories on GitHub <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="mt-12 hidden grid-cols-[3rem_1.4fr_1fr_1fr_1.5rem] gap-6 border-b border-line-strong pb-3 text-[0.7rem] font-bold tracking-[0.16em] text-muted uppercase md:grid">
        <span>No</span><span>Project</span><span>Role</span><span>Status</span><span></span>
      </div>

      <ol>
        {
          work.map((w, i) => (
            <li class="group relative border-b border-line">
              <div class="grid grid-cols-[2.25rem_1fr_1.25rem] gap-x-4 gap-y-1 py-6 md:grid-cols-[3rem_1.4fr_1fr_1fr_1.5rem] md:items-baseline md:gap-6">
                <span class="tnum pt-1 text-sm font-semibold text-muted md:pt-0">{pad(i + 1)}</span>
                <span>
                  <a href={`/work/${w.id}/`} class="block text-xl font-bold tracking-tight transition group-hover:text-gold-ink after:absolute after:inset-0 after:content-['']">
                    {w.data.title}
                  </a>
                  <span class="mt-1 block text-sm text-ink-soft">{w.data.kind}</span>
                  {i === 0 && <span class="mt-3 block h-[3px] w-24 bg-gold" aria-hidden="true" />}
                </span>
                <span class="row-start-2 col-start-2 text-sm text-ink-soft md:row-auto md:col-auto">{w.data.role}</span>
                <span class="row-start-3 col-start-2 text-sm md:row-auto md:col-auto">
                  <span class="font-semibold">{w.data.status}</span>
                  {w.data.highlight && <span class="block text-muted">{w.data.highlight}</span>}
                  {w.data.url && (
                    <a
                      href={w.data.url}
                      class="relative z-10 mt-2 inline-flex items-center gap-1 font-semibold text-ink underline decoration-gold decoration-2 underline-offset-4 hover:text-gold-ink"
                    >
                      Visit live site <span aria-hidden="true">↗</span>
                    </a>
                  )}
                </span>
                <span class="col-start-3 row-start-1 pt-1 text-right text-ink-soft transition group-hover:translate-x-1 group-hover:text-ink md:col-auto md:row-auto md:pt-0" aria-hidden="true">→</span>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ───────────── Capabilities ───────────── -->
  <section class="border-b border-line bg-surface/60">
    <div class="mx-auto grid max-w-6xl gap-12 px-4 py-20 sm:px-6 md:grid-cols-[1fr_2fr] md:py-24">
      <div>
        <p class="eyebrow">How I work</p>
        <h2 class="mt-4 text-3xl font-extrabold tracking-tight">AI is the easy part. Production is the job.</h2>
        <p class="mt-5 leading-relaxed text-ink-soft">
          A demo needs a prompt. A product needs guardrails, evaluation, cost control, integrations
          and someone who answers when it breaks. I've done that on both sides: as a founder shipping my own
          products, and as the engineer behind systems a whole university depends on.
        </p>
      </div>
      <div class="grid gap-8 sm:grid-cols-3">
        {
          capabilities.map((c) => (
            <div class="border-t-2 border-ink pt-5">
              <h3 class="font-bold">{c.title}</h3>
              <ul class="mt-4 space-y-2.5 text-sm text-ink-soft">
                {c.items.map((it) => <li>{it}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ───────────── Experience ───────────── -->
  <section id="experience" class="scroll-mt-24 border-b border-line">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 md:py-28">
      <p class="eyebrow">Experience</p>
      <h2 class="mt-4 text-3xl font-extrabold tracking-tight sm:text-4xl">5+ years, end to end</h2>
      <ol class="mt-12 border-t border-line-strong">
        {
          experience.map((e) => (
            <li class="grid gap-2 border-b border-line py-7 md:grid-cols-[13rem_1fr] md:gap-10">
              <span class="tnum text-sm font-semibold text-muted">{e.period}</span>
              <div>
                <h3 class="text-lg font-bold tracking-tight">
                  {e.role} <span class="font-medium text-ink-soft">· {e.org}</span>
                </h3>
                <p class="mt-2 max-w-3xl leading-relaxed text-ink-soft">{e.note}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ───────────── Speaking ───────────── -->
  <section id="speaking" class="scroll-mt-24 border-b border-line bg-surface/60">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-20 sm:px-6 md:grid-cols-2 md:py-24">
      <Image
        src={gdgPhoto}
        alt="Hijrah Assalam leading the Build With AI Solo 2026 workshop"
        widths={[480, 800, 1200]}
        sizes="(min-width: 768px) 560px, 100vw"
        class="aspect-[4/3] w-full object-cover"
      />
      <div>
        <p class="eyebrow">Speaking</p>
        <h2 class="mt-4 text-3xl font-extrabold tracking-tight">Build With AI Solo 2026</h2>
        <p class="mt-2 font-semibold text-ink-soft">Invited speaker · Google Developer Group Semarang</p>
        <p class="mt-5 leading-relaxed text-ink-soft">
          I led a hands-on workshop on Gemini and AI-assisted development: how to move from a prompt
          to a working application, using BundaGizi as the case study.
        </p>
        <blockquote class="mt-6 border-l-[3px] border-gold pl-5 text-lg font-semibold leading-snug">
          “Building AI is not about generating responses. It's about building products that create real value.”
        </blockquote>
        <a
          href="https://www.linkedin.com/posts/hijrahassalam_buildwithai-gdgsemarang-googleaistudio-ugcPost-7471541089368162304-VgXk/"
          class="mt-7 inline-flex items-center gap-2 text-sm font-semibold underline decoration-gold decoration-2 underline-offset-4"
        >
          Read the event recap <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ───────────── Recognition ───────────── -->
  <section class="border-b border-line">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <p class="eyebrow">Recognition &amp; credentials</p>
      <ul class="mt-10 grid border-t border-l border-line sm:grid-cols-2 lg:grid-cols-3">
        {
          recognition.map((r) => (
            <li class="border-r border-b border-line p-6">
              <p class="font-bold">{r.title}</p>
              <p class="mt-1 text-sm text-ink-soft">{r.detail}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ───────────── Contact ───────────── -->
  <section id="contact" class="kawung kawung-gold scroll-mt-24 bg-[#16304f] text-[#eef1f5]">
    <TumpalBand tone="gold" />
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-20 sm:px-6 md:grid-cols-[1.4fr_1fr] md:items-end md:py-24">
      <div>
        <p class="text-xs font-bold tracking-[0.16em] text-[#e2c057] uppercase">Work with me</p>
        <h2 class="mt-4 text-3xl leading-tight font-extrabold tracking-tight text-balance sm:text-5xl">
          Have an AI product that needs to work in the real world?
        </h2>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-[#c3ccd8]">
          I'm open to Applied AI and senior engineering roles, remote or hybrid, and to selected product collaborations.
          Fluent in English (C1), async-friendly, based in GMT+7.
        </p>
      </div>
      <div class="flex flex-col gap-3">
        <a href={`mailto:${site.email}`} class="flex items-center justify-between rounded-md bg-[#e2c057] px-5 py-4 font-semibold text-[#16304f] transition hover:opacity-90">
          {site.email}
          <span aria-hidden="true">→</span>
        </a>
        <a href={site.links.linkedin} class="flex items-center justify-between rounded-md border border-white/20 px-5 py-4 font-semibold transition hover:border-white/50">
          LinkedIn <span aria-hidden="true">↗</span>
        </a>
        <a href={site.cv} class="flex items-center justify-between rounded-md border border-white/20 px-5 py-4 font-semibold transition hover:border-white/50">
          Download CV <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
