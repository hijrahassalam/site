---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import StatusHUD from '../components/StatusHUD.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ResearchPreview from '../components/ResearchPreview.astro';
import JourneyMap from '../components/JourneyMap.astro';
import QuestCard from '../components/QuestCard.astro';
import PixelButton from '../components/PixelButton.astro';
import PixelBadge from '../components/PixelBadge.astro';
import avatar from '../assets/pixel-avatar.png';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const currentBuilds = projects.filter((p) => p.data.category === 'current');
const production = projects.filter((p) => p.data.category === 'production');
const tooling = projects.filter((p) => p.data.category === 'tooling');

const researchEntry = (await getCollection('research')).sort(
  (a, b) => a.data.order - b.data.order
)[0];
const nowEntry = (await getCollection('now'))[0];

const journey = [
  {
    year: '2021',
    title: 'Software engineering',
    note: 'Starting point: building and shipping web systems end to end.',
    state: 'done' as const,
  },
  { title: 'Full-stack development', note: 'Backend, frontend, and deployment in one loop.', state: 'done' as const },
  {
    title: 'Enterprise systems',
    note: 'Institutional workflows at scale — approvals, integrations, audit trails.',
    state: 'done' as const,
  },
  { title: 'AI product building', note: 'Shipping AI products with real users and real constraints.', state: 'done' as const },
  {
    year: '2026',
    title: 'Applied AI',
    note: 'Production AI products: AsistenDiet and BidikTender.',
    state: 'current' as const,
  },
  { title: 'Biomedical AI', note: 'Interpretability for medical imaging models.', state: 'current' as const },
  {
    title: 'Next region — graduate study',
    note: 'Preparing graduate research in biomedical AI.',
    state: 'next' as const,
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Hijrah Assalam',
    url: 'https://www.hijrahassalam.com',
    jobTitle: 'AI Builder & Full-Stack Engineer',
    email: 'mailto:hello@hijrahassalam.com',
    sameAs: ['https://github.com/hijrahassalam', 'https://linkedin.com/in/hijrahassalam'],
    knowsAbout: [
      'Applied AI',
      'Full-Stack Engineering',
      'Enterprise Systems',
      'Explainable AI',
      'Biomedical AI',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Hijrah Assalam',
    url: 'https://www.hijrahassalam.com',
  },
];
---

<BaseLayout
  title="Hijrah Assalam — AI Builder & Full-Stack Engineer"
  description="Hijrah Assalam builds production AI products and full-stack systems, with a growing research direction in biomedical AI."
  jsonLd={jsonLd}
>
  <!-- HERO (§17–§19) -->
  <section class="mx-auto max-w-6xl px-4 pb-14 pt-12 sm:px-6 sm:pt-16 lg:pt-20">
    <div class="grid items-start gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-14">
      <div class="reveal">
        <p class="eyebrow">Player profile</p>

        <h1
          class="mt-4 text-[2.125rem] font-semibold leading-[1.05] tracking-tight text-ink sm:text-5xl lg:text-[3.5rem]"
        >
          Hijrah Assalam
        </h1>

        <p class="mt-4 text-lg font-medium text-cyan-400 sm:text-xl">
          AI Builder &amp; Full-Stack Engineer
        </p>

        <p class="mt-4 max-w-xl text-[1.0625rem] leading-relaxed text-ink-2">
          Building AI products today. Working toward biomedical AI tomorrow.
        </p>

        <div class="mt-7 flex flex-wrap gap-3">
          <PixelButton href="/work">Explore work</PixelButton>
          <PixelButton href="/hire" variant="ghost">Hire me</PixelButton>
        </div>

        <div class="mt-7 flex flex-wrap items-center gap-x-4 gap-y-2">
          <span class="hud-label flex items-center gap-2">
            <span class="dot dot-live" aria-hidden="true"></span>
            Available for remote work
          </span>
          <span class="hud-label text-ink-3">GMT+7</span>
        </div>
      </div>

      <div class="reveal">
        <div class="px-frame mx-auto max-w-[22rem] bg-ink/15 p-[2px] lg:max-w-none">
          <div class="px-frame bg-bg-base">
            <Image
              src={avatar}
              alt="Pixel-art portrait of Hijrah Assalam"
              widths={[320, 480, 660]}
              sizes="(max-width: 1024px) 70vw, 360px"
              loading="eager"
              class="h-auto w-full"
            />
          </div>
        </div>

        <StatusHUD class="mt-5" />
      </div>
    </div>
  </section>

  <!-- CURRENT BUILDS (§20–§22) -->
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <SectionHeader
      eyebrow="Active quests"
      title="Current builds"
      description="The two products I am actively building — one consumer AI product, one enterprise AI platform."
      accent="mint"
    />

    <div class="mt-8 space-y-6">
      {
        currentBuilds.map((project) => (
          <div class="reveal">
            <ProjectCard project={project.data} slug={project.id} variant="feature" />
          </div>
        ))
      }
    </div>
  </section>

  <!-- PRODUCTION EXPERIENCE (§23) -->
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <SectionHeader
      eyebrow="Production proof"
      title="Systems running in production"
      description="Not experiments — platforms used daily, at institutional and national scale."
      accent="mint"
    />

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        production.map((project) => (
          <article class="panel reveal flex flex-col justify-between p-5">
            <div>
              <div class="flex items-center justify-between gap-3">
                <h3 class="text-base font-semibold text-ink">{project.data.title}</h3>
                <span class="dot dot-live" aria-hidden="true" />
              </div>
              <p class="hud-label mt-2 text-ink-3">{project.data.role}</p>

              <dl class="mt-4 space-y-2.5 border-t border-ink/10 pt-4">
                {(project.data.metrics ?? []).slice(0, 3).map((metric) => (
                  <div class="flex items-baseline justify-between gap-3">
                    <dd class="hud-value text-mint-400">{metric.value}</dd>
                    <dt class="hud-label text-ink-3">{metric.label}</dt>
                  </div>
                ))}
              </dl>
            </div>

            {project.data.hasDetail && (
              <a href={`/work/${project.id}`} class="hud-label mt-5 text-ink-2 hover:text-cyan-400">
                Detail &#8594;
              </a>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <!-- JOURNEY MAP (§29 preview) -->
  <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <SectionHeader
      eyebrow="Journey"
      title="An evolving path, not a static CV"
      description="Software engineering, then enterprise systems, then AI products — and now a research direction in biomedical AI."
      accent="amber"
    />

    <div class="reveal mt-8 grid gap-10 lg:grid-cols-[1.05fr_0.95fr]">
      <JourneyMap nodes={journey} />

      <div class="panel h-fit p-5 sm:p-6">
        <p class="hud-label">Long-term direction</p>
        <p class="mt-3 text-[0.9375rem] leading-relaxed text-ink-2">
          The progression is deliberate. Enterprise systems taught me to build for failure and
          auditability. AI products taught me to ship under real user constraints. Biomedical AI is
          where I want to apply both — building models that are not only accurate, but accountable.
        </p>
        <div class="mt-5 flex flex-wrap gap-2">
          <PixelBadge label="Engineering" accent="cyan" />
          <PixelBadge label="Products" accent="mint" />
          <PixelBadge label="Research" accent="violet" />
          <PixelBadge label="Journey" accent="amber" />
        </div>
        <a href="/journey" class="hud-label mt-6 inline-flex text-amber-400">
          Full journey map &#8594;
        </a>
      </div>
    </div>
  </section>

  <!-- FEATURED WORK / TOOLING -->
  {
    tooling.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
        <SectionHeader
          eyebrow="Capability"
          title="AI engineering &amp; tooling"
          description="How the work gets done — agent orchestration, model provider management, and workflow automation."
          accent="cyan"
        />

        <div class="mt-8 space-y-4">
          {tooling.map((project) => (
            <div class="reveal">
              <ProjectCard project={project.data} slug={project.id} variant="compact" />
            </div>
          ))}
        </div>

        <div class="reveal mt-8">
          <PixelButton href="/work" variant="ghost">
            All work
          </PixelButton>
        </div>
      </section>
    )
  }

  <!-- RESEARCH PATH (§31–§34 preview) -->
  {
    researchEntry && (
      <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
        <SectionHeader
          eyebrow="Research path"
          title="Explainable AI for medical imaging"
          description="Grad-CAM used as a diagnostic instrument — including the finding that the model sometimes looks in the wrong place."
          accent="violet"
        />

        <div class="reveal mt-8">
          <ResearchPreview
            title={researchEntry.data.title}
            positioning={researchEntry.data.positioning}
            pipeline={researchEntry.data.pipeline}
            metrics={researchEntry.data.metrics}
            findingTitle={researchEntry.data.findingTitle}
            findingWarning={researchEntry.data.findingWarning}
            href="/research"
          />
        </div>
      </section>
    )
  }

  <!-- NOW (§30 preview) -->
  {
    nowEntry && (
      <section class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
        <SectionHeader
          eyebrow="Quest log"
          title="What I'm doing now"
          description={`Status per ${nowEntry.data.updated} — short lines only, no inflated progress bars.`}
          accent="amber"
        />

        <div class="reveal mt-8 space-y-2">
          {nowEntry.data.quests.slice(0, 4).map((quest) => (
            <QuestCard
              kind={quest.kind}
              title={quest.title}
              status={quest.status}
              statusKind={quest.statusKind}
              note={quest.note}
              accent={quest.accent}
              href={quest.href}
            />
          ))}
        </div>

        <div class="reveal mt-6">
          <a href="/now" class="hud-label text-amber-400">
            Full quest log &#8594;
          </a>
        </div>
      </section>
    )
  }

  <!-- CONTACT CTA (§39) -->
  <section class="mx-auto max-w-6xl px-4 py-14 pb-4 sm:px-6">
    <div class="panel reveal relative overflow-hidden p-6 sm:p-10">
      <span class="absolute inset-x-0 top-0 h-[2px] bg-cyan-400" aria-hidden="true"></span>

      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div>
          <p class="eyebrow">Communication terminal</p>
          <h2 class="mt-3 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
            Let's build something that holds up in production.
          </h2>
          <p class="mt-3 max-w-xl text-[0.9375rem] leading-relaxed text-ink-2">
            Open to remote roles, product collaborations, and research conversations.
          </p>
        </div>

        <div class="flex flex-wrap gap-3">
          <PixelButton href="/contact">Send message</PixelButton>
          <PixelButton href="/hire" variant="ghost">Hire me</PixelButton>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
