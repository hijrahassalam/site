---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PixelLabel from '../components/PixelLabel.astro';
import PixelButton from '../components/PixelButton.astro';
import SaveScreen from '../components/SaveScreen.astro';

const entries = (await getCollection('now')).sort((a, b) => b.id.localeCompare(a.id));
const now = entries[0];

const quests = now.data.quests.map((quest) => ({
  title: quest.title,
  status: quest.status,
  accent: quest.accent,
  href: quest.href,
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Now — Hijrah Assalam',
  url: 'https://www.hijrahassalam.com/now',
  description: 'Current quest log: what Hijrah Assalam is building, running, and researching right now.',
};
---

<BaseLayout
  title="Now — Hijrah Assalam"
  description="Current quest log: products in development, production systems, and the next research objective."
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-5xl px-4 pb-10 pt-12 sm:px-6 sm:pt-16">
    <PixelLabel label="Quest log" accent="amber" cursor />
    <h1 class="mt-4 text-[2rem] font-semibold leading-tight tracking-tight text-ink sm:text-4xl">
      Continue from save file
    </h1>
    <p class="mt-4 max-w-xl text-base leading-relaxed text-ink-2">
      A truthful snapshot of what is active now — stages, not invented percentages.
    </p>

    <div class="mt-10">
      <SaveScreen
        slot="Save file 01 · Current"
        quests={quests}
        updated={now.data.updated}
        nextObjective={{
          title: 'Graduate study',
          note: 'Preparing graduate research in biomedical AI, targeting Japan.',
        }}
      />
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-8 sm:px-6">
    <div class="grid gap-5 lg:grid-cols-[1fr_auto] lg:items-center">
      <div>
        <PixelLabel label="Next move" accent="amber" />
        <h2 class="mt-3 text-xl font-semibold text-ink sm:text-2xl">Inspect a quest or start a conversation.</h2>
      </div>
      <div class="flex flex-wrap gap-3">
        <PixelButton href="/work">Explore work</PixelButton>
        <PixelButton href="/contact" variant="ghost">Get in touch</PixelButton>
      </div>
    </div>
  </section>
</BaseLayout>
