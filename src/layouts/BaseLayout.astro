---
import '@fontsource-variable/plus-jakarta-sans';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.titleRole}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/assets/images/og-image.png', Astro.site);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  alternateName: site.legalName,
  // jobTitle matches the current employer (worksFor); hasOccupation carries the full identity.
  jobTitle: site.role,
  hasOccupation: [
    { '@type': 'Occupation', name: 'Senior Software Engineer' },
    { '@type': 'Occupation', name: 'Applied AI Engineer' },
  ],
  url: Astro.site?.toString(),
  email: `mailto:${site.email}`,
  image: new URL('/assets/images/profile.webp', Astro.site).toString(),
  sameAs: [site.links.github, site.links.linkedin],
  knowsAbout: [
    'Software engineering', 'Backend development', 'Full-stack development', 'REST APIs',
    'System integration', 'PHP', 'Laravel', 'Node.js', 'Vue.js', 'PostgreSQL', 'MySQL', 'Docker',
    'Applied AI', 'LLM applications', 'AI agents', 'RAG', 'Guardrails', 'LLM evaluation',
  ],
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Universitas Sebelas Maret' },
  worksFor: { '@type': 'Organization', name: 'Universitas Sebelas Maret' },
  homeLocation: { '@type': 'Place', name: 'Surakarta, Indonesia' },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.legalName} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f7f6f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#071425" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Hijrah Assalam, Senior Software Engineer and Applied AI Engineer, Surakarta, Indonesia: I build AI products people actually use. hijrahassalam.com" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <!-- Apply a saved theme choice before paint to avoid a flash. -->
    <script is:inline>
      try {
        if (!sessionStorage.getItem('kc-intro')) {
          document.documentElement.classList.add('kc-intro');
          sessionStorage.setItem('kc-intro', '1');
        }
      } catch (_) {}
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (_) {}
    </script>

    <!-- Analytics (unchanged from the previous site) -->
    <script is:inline defer data-domain="hijrahassalam.com" src="https://plausible.io/js/script.js"></script>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-9YYE9X6L4E"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-9YYE9X6L4E');
    </script>
    <script is:inline defer src="/analytics.js"></script>
  </head>
  <body class="min-h-dvh flex flex-col text-ink">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-surface focus:px-4 focus:py-2 focus:text-sm focus:font-semibold"
    >
      Skip to content
    </a>
    <SiteHeader />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
