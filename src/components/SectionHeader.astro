---
import type { Accent } from '../lib/accent';
import { accents } from '../lib/accent';

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  accent?: Accent;
  id?: string;
  class?: string;
}

const { eyebrow, title, description, accent = 'cyan', id, class: className = '' } = Astro.props;
const a = accents[accent];
---

<div id={id} class:list={['reveal', className]}>
  <div class="flex items-start gap-3">
    <span class:list={['mt-1 h-8 w-[3px] flex-none', a.bg]} aria-hidden="true"></span>
    <div class="min-w-0">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2 class="mt-2 text-[1.375rem] font-semibold leading-tight text-ink sm:text-3xl">
        {title}
      </h2>
    </div>
  </div>
  {
    description && (
      <p class="mt-3 max-w-2xl pl-[calc(3px+0.75rem)] text-[0.9375rem] leading-relaxed text-ink-2">
        {description}
      </p>
    )
  }
</div>
