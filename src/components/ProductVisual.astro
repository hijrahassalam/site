---
/**
 * Mockup produk skematik (§3 mengizinkan "product mockups").
 * Ini BUKAN tangkapan layar palsu — bentuknya jelas skematik dan akan diganti
 * screenshot asli begitu tersedia.
 */
interface Props {
  variant: 'asistendiet' | 'bidiktender' | 'uns';
  class?: string;
}

const { variant, class: className = '' } = Astro.props;

const macros = [
  { label: 'Kalori', value: '520', unit: 'kkal', pct: 68, color: 'bg-mint-400' },
  { label: 'Protein', value: '32', unit: 'g', pct: 74, color: 'bg-cyan-400' },
  { label: 'Karbo', value: '58', unit: 'g', pct: 52, color: 'bg-amber-400' },
  { label: 'Lemak', value: '14', unit: 'g', pct: 34, color: 'bg-violet-400' },
];

const weightBars = [78, 74, 71, 66, 63, 58, 55];

const requirements = [
  { code: '1.2', text: 'Akta pendirian & perubahan', state: 'ok' },
  { code: '2.4', text: 'SBU konstruksi klasifikasi', state: 'ok' },
  { code: '3.1', text: 'Pengalaman proyek sejenis', state: 'warn' },
  { code: '4.7', text: 'Laporan keuangan 3 tahun', state: 'miss' },
];

const unsFlow = [
  'Surat tugas',
  'Approval',
  'Digisign',
  'SPPD',
  'Verification',
  'Payment',
];
---

{
  variant === 'asistendiet' ? (
    <div class:list={['grid gap-4 sm:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]', className]}>
      {/* PHONE — percakapan WhatsApp */}
      <div class="mx-auto w-full max-w-[240px]">
        <div class="rounded-[14px] border-2 border-ink/20 bg-bg-deep p-2 shadow-[0_0_40px_-12px_rgba(69,230,181,0.35)]">
          <div class="rounded-[9px] bg-bg-base p-3">
            <div class="flex items-center gap-2 border-b border-ink/10 pb-2">
              <span class="dot dot-live" aria-hidden="true"></span>
              <span class="hud-label text-mint-400">AsistenDiet</span>
            </div>

            {/* pesan pengguna */}
            <div class="mt-3 flex justify-end">
              <div class="max-w-[86%] rounded-[6px] rounded-br-[2px] border border-mint-400/30 bg-mint-400/10 p-2">
                <div class="flex h-12 w-20 items-center justify-center rounded-[3px] border border-mint-400/25 bg-bg-surface">
                  <span class="hud-label text-ink-3">foto</span>
                </div>
              </div>
            </div>

            {/* balasan asisten */}
            <div class="mt-2 flex justify-start">
              <div class="w-[92%] rounded-[6px] rounded-bl-[2px] border border-ink/15 bg-bg-surface p-2.5">
                <p class="hud-label text-ink-3">Analisis</p>
                <ul class="mt-2 space-y-1.5">
                  {macros.map((m) => (
                    <li>
                      <div class="flex items-baseline justify-between gap-2">
                        <span class="hud-label text-ink-2">{m.label}</span>
                        <span class="text-[11px] font-medium text-ink">
                          {m.value}
                          <span class="text-ink-3">{m.unit}</span>
                        </span>
                      </div>
                      <div class="progress-track mt-1">
                        <div class:list={['progress-fill text-transparent', m.color]} style={`width:${m.pct}%`} />
                      </div>
                    </li>
                  ))}
                </ul>
                <p class="mt-2.5 border-t border-ink/10 pt-2 text-[11px] text-mint-400">
                  Sesuai target cutting
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* WEB DASHBOARD */}
      <div class="panel self-center p-4">
        <div class="flex items-center justify-between">
          <span class="hud-label text-ink-3">Weight progress</span>
          <span class="hud-label text-mint-400">-3,4 kg</span>
        </div>

        <div class="mt-4 flex h-28 items-end gap-2">
          {weightBars.map((h, i) => (
            <div class="flex flex-1 flex-col items-center gap-1.5">
              <div
                class:list={[
                  'w-full rounded-[1px]',
                  i === weightBars.length - 1 ? 'bg-mint-400' : 'bg-mint-400/35',
                ]}
                style={`height:${h}%`}
              />
              <span class="coord">W{i + 1}</span>
            </div>
          ))}
        </div>

        <dl class="mt-4 grid grid-cols-3 gap-3 border-t border-ink/10 pt-3">
          <div>
            <dt class="hud-label text-ink-3">Goal</dt>
            <dd class="mt-1 text-xs font-medium text-ink">Cutting</dd>
          </div>
          <div>
            <dt class="hud-label text-ink-3">Streak</dt>
            <dd class="mt-1 text-xs font-medium text-ink">12 hari</dd>
          </div>
          <div>
            <dt class="hud-label text-ink-3">Log</dt>
            <dd class="mt-1 text-xs font-medium text-ink">Hari ini</dd>
          </div>
        </dl>
      </div>
    </div>
  ) : variant === 'bidiktender' ? (
    <div class:list={['space-y-4', className]}>
      {/* DIAGRAM ALUR */}
      <ol class="flex flex-wrap items-center gap-x-2 gap-y-2">
        {
          ['PDF', 'AI', 'Requirements', 'Matching', 'Readiness'].map((step, i, arr) => (
            <>
              <li class="hud-value rounded-[2px] border border-cyan-400/40 bg-cyan-400/10 px-2.5 py-1 text-cyan-400">
                {step}
              </li>
              {i < arr.length - 1 && (
                <li class="hud-label text-ink-3" aria-hidden="true">
                  &#8594;
                </li>
              )}
            </>
          ))
        }
      </ol>

      {/* WORKSPACE PERSYARATAN */}
      <div class="panel overflow-hidden">
        <div class="flex items-center justify-between border-b border-ink/10 bg-bg-base/50 px-3 py-2">
          <span class="hud-label text-ink-2">Requirement workspace</span>
          <span class="hud-label text-amber-400">2 blockers</span>
        </div>
        <ul class="divide-y divide-ink/8">
          {
            requirements.map((r) => (
              <li class="flex items-center gap-3 px-3 py-2.5">
                <span class="coord w-6 flex-none">{r.code}</span>
                <span class="min-w-0 flex-1 truncate text-xs text-ink-2">{r.text}</span>
                <span
                  class:list={[
                    'hud-label flex-none',
                    r.state === 'ok' && 'text-mint-400',
                    r.state === 'warn' && 'text-amber-400',
                    r.state === 'miss' && 'text-ink-3',
                  ]}
                >
                  {r.state === 'ok' ? 'terpenuhi' : r.state === 'warn' ? 'kurang' : 'belum'}
                </span>
              </li>
            ))
          }
        </ul>
        <div class="border-t border-ink/10 px-3 py-2.5">
          <div class="flex items-center justify-between">
            <span class="hud-label text-ink-3">Readiness</span>
            <span class="hud-label text-cyan-400">72%</span>
          </div>
          <div class="progress-track mt-2">
            <div class="progress-fill text-cyan-400" style="width:72%"></div>
          </div>
        </div>
      </div>
    </div>
  ) : (
    <div class:list={['flex flex-wrap items-center gap-x-2 gap-y-2', className]}>
      {
        unsFlow.map((step, i, arr) => (
          <>
            <span class="hud-value rounded-[2px] border border-mint-400/40 bg-mint-400/10 px-2.5 py-1 text-mint-400">
              {step}
            </span>
            {i < arr.length - 1 && (
              <span class="hud-label text-ink-3" aria-hidden="true">
                &#8594;
              </span>
            )}
          </>
        ))
      }
    </div>
  )
}
