---
// Kawung Convergence horizontal logo (symbol + "Hijrah Assalam"), theme-aware.
import raw from '../brand/kc-horizontal.svg?raw';
import { themeSvg } from '../brand/theme-svg';

interface Props {
  class?: string;
  /** Draw the symbol's arcs, then drop in the centre dot. */
  draw?: boolean;
  label?: string;
}
const { class: className = '', label, draw = false } = Astro.props;
const svg = themeSvg(raw, { label, className: `block h-auto ${draw ? 'kc-draw-intro' : ''} ${className}` });
---

<Fragment set:html={svg} />
