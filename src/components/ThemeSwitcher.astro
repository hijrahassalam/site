---
// Three-way theme control: Light, Dark, or follow the System setting.
// The choice is stored in localStorage; "system" removes the override.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const options = [
  { value: 'light', label: 'Light' },
  { value: 'dark', label: 'Dark' },
  { value: 'system', label: 'System' },
] as const;
---

<div
  role="group"
  aria-label="Colour theme"
  class:list={['inline-flex items-center gap-0.5 rounded-full border border-line-strong bg-surface p-0.5', className]}
>
  {
    options.map((o) => (
      <button
        type="button"
        data-theme-choice={o.value}
        aria-pressed="false"
        title={`${o.label} theme`}
        class="grid size-7 cursor-pointer place-items-center rounded-full text-muted transition hover:text-ink aria-pressed:bg-ink aria-pressed:text-paper"
      >
        <span class="sr-only">{o.label}</span>
        {o.value === 'light' && (
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
          </svg>
        )}
        {o.value === 'dark' && (
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z" />
          </svg>
        )}
        {o.value === 'system' && (
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="4" width="18" height="12" rx="2" />
            <path d="M8 20h8M12 16v4" />
          </svg>
        )}
      </button>
    ))
  }
</div>

<script>
  type Choice = 'light' | 'dark' | 'system';

  function read(): Choice {
    try {
      const v = localStorage.getItem('theme');
      if (v === 'light' || v === 'dark') return v;
    } catch (_) {}
    return 'system';
  }

  function apply(choice: Choice) {
    const root = document.documentElement;
    if (choice === 'system') delete root.dataset.theme;
    else root.dataset.theme = choice;
    try {
      if (choice === 'system') localStorage.removeItem('theme');
      else localStorage.setItem('theme', choice);
    } catch (_) {}
    document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]').forEach((b) => {
      b.setAttribute('aria-pressed', String(b.dataset.themeChoice === choice));
    });
  }

  apply(read());
  document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]').forEach((b) => {
    b.addEventListener('click', () => apply(b.dataset.themeChoice as Choice));
  });
</script>
