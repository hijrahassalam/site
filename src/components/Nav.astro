---
const links = [
  { href: '/', label: 'Home' },
  { href: '/work', label: 'Work' },
  { href: '/research', label: 'Research' },
  { href: '/journey', label: 'Journey' },
  { href: '/now', label: 'Now' },
  { href: '/contact', label: 'Contact' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="sticky top-0 z-50 border-b border-ink/10 bg-bg-deep/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-4 sm:px-6">
    <a href="/" class="flex flex-none items-center gap-2.5" aria-label="hijrahassalam — home">
      <span
        class="grid h-6 w-6 flex-none place-items-center border border-cyan-400/50 bg-cyan-400/10"
        aria-hidden="true"
      >
        <span class="h-2 w-2 bg-cyan-400"></span>
      </span>
      <span class="hud-value text-ink">hijrahassalam</span>
    </a>

    <nav class="hidden items-center gap-0.5 md:flex" aria-label="Utama">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'hud-label px-2.5 py-2 transition-colors duration-150',
              isActive(link.href) ? 'text-cyan-400' : 'text-ink-2 hover:text-ink',
            ]}
          >
            {isActive(link.href) && (
              <span class="mr-1.5 inline-block" aria-hidden="true">
                &#9656;
              </span>
            )}
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex flex-none items-center gap-2">
      <a href="/hire" class="btn btn-primary hidden md:inline-flex">Hire me</a>
      <button
        type="button"
        id="nav-toggle"
        class="btn btn-ghost !px-3 md:hidden"
        aria-expanded="false"
        aria-controls="nav-mobile"
      >
        <span class="sr-only">Buka menu</span>
        <span aria-hidden="true">&#9776;</span>
      </button>
    </div>
  </div>

  <div id="nav-mobile" class="hidden border-t border-ink/10 bg-bg-base md:hidden">
    <nav class="mx-auto max-w-6xl px-4 py-3" aria-label="Utama (mobile)">
      <ul class="divide-y divide-ink/8">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? 'page' : undefined}
                class:list={[
                  'flex min-h-[44px] items-center hud-label',
                  isActive(link.href) ? 'text-cyan-400' : 'text-ink-2',
                ]}
              >
                {isActive(link.href) && (
                  <span class="mr-2 inline-block" aria-hidden="true">
                    &#9656;
                  </span>
                )}
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/hire" class="flex min-h-[44px] items-center hud-label text-cyan-400">
            &#9656; Hire me
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('nav-mobile');

  if (toggle && panel) {
    toggle.addEventListener('click', () => {
      const open = panel.classList.toggle('hidden') === false;
      toggle.setAttribute('aria-expanded', String(open));
    });
  }
</script>
