---
import { site } from '../data/profile';

const nav = [
  { href: '/#work', label: 'Work' },
  { href: '/research/', label: 'Research' },
  { href: '/now/', label: 'Now' },
  { href: '/contact/', label: 'Contact' },
];
const path = Astro.url.pathname;
const isActive = (href: string) => !href.startsWith('/#') && path.startsWith(href);
---

<header class="sticky top-0 z-40 bg-paper/85 backdrop-blur-md">
  <div class="letterhead"></div>
  <div class="border-b border-line">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-4 py-4 sm:px-6">
      <a href="/" class="group flex items-center gap-3" aria-label={`${site.name}, home`}>
        <span
          class="grid size-9 place-items-center rounded-full border border-line-strong text-[0.8rem] font-extrabold tracking-tight text-ink transition group-hover:border-gold"
          aria-hidden="true">HA</span
        >
        <span class="leading-tight">
          <span class="block text-[0.95rem] font-bold tracking-tight">{site.name}</span>
          <span class="block text-xs text-muted">{site.role}</span>
        </span>
      </a>

      <nav aria-label="Primary" class="hidden items-center gap-8 md:flex">
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class="text-sm font-semibold text-ink-soft transition hover:text-ink aria-[current=page]:text-ink aria-[current=page]:underline aria-[current=page]:decoration-gold aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-8"
            >
              {item.label}
            </a>
          ))
        }
        <a
          href="/hire/"
          class="rounded-md bg-ink px-4 py-2 text-sm font-semibold text-paper transition hover:opacity-90"
        >
          Work with me
        </a>
      </nav>

      <div class="flex items-center gap-2 md:hidden">
        <a href="/hire/" class="rounded-md bg-ink px-3 py-2 text-xs font-semibold text-paper">Hire me</a>
        <details class="relative">
          <summary
            class="grid size-9 cursor-pointer list-none place-items-center rounded-md border border-line-strong [&::-webkit-details-marker]:hidden"
            aria-label="Menu"
          >
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M2 4.5h12M2 8h12M2 11.5h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
            </svg>
          </summary>
          <div class="absolute right-0 mt-2 w-48 rounded-md border border-line bg-surface p-2 shadow-lg">
            {
              nav.map((item) => (
                <a href={item.href} class="block rounded px-3 py-2 text-sm font-semibold text-ink-soft hover:bg-paper hover:text-ink">
                  {item.label}
                </a>
              ))
            }
          </div>
        </details>
      </div>
    </div>
  </div>
</header>
