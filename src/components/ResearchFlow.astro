---
import MetricBlock from './MetricBlock.astro';

interface Props {
  pipeline: string[];
  metrics: { value: string; label: string }[];
  /** tampilkan perbandingan expected vs observed (§24) — dipakai penuh di /research */
  comparison?: boolean;
  findingWarning?: string;
  class?: string;
}

const { pipeline, metrics, comparison = false, findingWarning = '', class: className = '' } = Astro.props;
---

<div class:list={[className]}>
  <!-- ALUR VISUAL (§23) -->
  <div class="flex flex-col gap-3 lg:flex-row lg:items-stretch">
    {
      pipeline.map((stage, i) => (
        <>
          <div class="panel relative flex-1 overflow-hidden p-4">
            <span class="hud-label text-violet-400">0{i + 1}</span>

            <div class="mt-3 flex h-24 items-center justify-center">
              {i === 0 && (
                <svg viewBox="0 0 120 80" class="h-20 w-auto" role="img" aria-label="Skema citra rontgen dada">
                  <rect x="8" y="6" width="104" height="68" fill="none" stroke="#A78BFA" stroke-opacity="0.4" />
                  <rect x="22" y="16" width="32" height="48" fill="none" stroke="#A78BFA" stroke-opacity="0.6" />
                  <rect x="66" y="16" width="32" height="48" fill="none" stroke="#A78BFA" stroke-opacity="0.6" />
                </svg>
              )}
              {i === 1 && (
                <svg viewBox="0 0 120 80" class="h-20 w-auto" role="img" aria-label="Skema lapisan jaringan CNN">
                  <g fill="none" stroke="#A78BFA" stroke-opacity="0.55">
                    <rect x="18" y="10" width="20" height="60" />
                    <rect x="50" y="18" width="20" height="44" stroke-opacity="0.75" />
                    <rect x="82" y="26" width="20" height="28" stroke-opacity="0.95" />
                  </g>
                  <g fill="#A78BFA" fill-opacity="0.25">
                    <rect x="52" y="20" width="16" height="40" />
                    <rect x="84" y="28" width="16" height="24" />
                  </g>
                </svg>
              )}
              {i === 2 && (
                <svg viewBox="0 0 120 80" class="h-20 w-auto" role="img" aria-label="Skema hasil klasifikasi tiga kelas">
                  <g>
                    <rect x="14" y="18" width="92" height="9" fill="#A78BFA" fill-opacity="0.2" />
                    <rect x="14" y="36" width="92" height="9" fill="#A78BFA" fill-opacity="0.12" />
                    <rect x="14" y="54" width="92" height="9" fill="#A78BFA" fill-opacity="0.35" />
                  </g>
                  <rect x="14" y="54" width="64" height="9" fill="#A78BFA" fill-opacity="0.7" />
                </svg>
              )}
              {i === 3 && (
                <svg viewBox="0 0 120 80" class="h-20 w-auto" role="img" aria-label="Skema peta perhatian Grad-CAM">
                  <rect x="8" y="6" width="104" height="68" fill="none" stroke="#A78BFA" stroke-opacity="0.4" />
                  <rect x="22" y="16" width="32" height="48" fill="none" stroke="#A78BFA" stroke-opacity="0.6" />
                  <rect x="66" y="16" width="32" height="48" fill="none" stroke="#A78BFA" stroke-opacity="0.6" />
                  <rect x="26" y="22" width="26" height="36" fill="#C084FC" fill-opacity="0.45" />
                  <rect x="70" y="28" width="18" height="26" fill="#C084FC" fill-opacity="0.22" />
                </svg>
              )}
              {i === 4 && (
                <svg viewBox="0 0 120 80" class="h-20 w-auto" role="img" aria-label="Skema pemeriksaan interpretabilitas model">
                  <rect x="10" y="9" width="100" height="62" fill="none" stroke="#A78BFA" stroke-opacity="0.35" />
                  <rect x="20" y="20" width="34" height="40" fill="none" stroke="#45E6B5" stroke-opacity="0.75" />
                  <rect x="66" y="20" width="34" height="40" fill="none" stroke="#FBCB5D" stroke-opacity="0.75" />
                  <path d="M54 40 H66" stroke="#A78BFA" stroke-opacity="0.8" stroke-dasharray="2 2" />
                  <rect x="25" y="27" width="24" height="26" fill="#45E6B5" fill-opacity="0.3" />
                  <rect x="84" y="24" width="12" height="12" fill="#FBCB5D" fill-opacity="0.4" />
                </svg>
              )}
            </div>

            <p class="hud-value mt-3 text-ink">{stage}</p>
          </div>

          {i < pipeline.length - 1 && (
            <div class="flex flex-none items-center justify-center" aria-hidden="true">
              <span class="hud-label text-violet-400/70 lg:hidden">&#8595;</span>
              <span class="hud-label hidden text-violet-400/70 lg:inline">&#8594;</span>
            </div>
          )}
        </>
      ))
    }
  </div>

  <!-- METRIK (§23) -->
  <dl class="mt-6 grid grid-cols-2 gap-5 sm:grid-cols-4">
    {
      metrics.map((metric) => (
        <MetricBlock value={metric.value} label={metric.label} accent="violet" />
      ))
    }
  </dl>

  <!-- PERBANDINGAN (§24) -->
  {
    comparison && (
      <div class="mt-8">
        <p class="hud-label text-ink-3">Expected vs observed attention</p>

        <div class="mt-3 grid gap-3 sm:grid-cols-2">
          <figure class="panel overflow-hidden">
            <div class="scanlines relative flex h-40 items-center justify-center bg-bg-base/60">
              <svg viewBox="0 0 160 90" class="h-32 w-auto" role="img" aria-label="Perhatian model di dalam area paru">
                <rect x="6" y="4" width="148" height="82" fill="none" stroke="#F4F7FC" stroke-opacity="0.18" />
                <rect x="30" y="18" width="42" height="58" fill="none" stroke="#A78BFA" stroke-opacity="0.5" />
                <rect x="88" y="18" width="42" height="58" fill="none" stroke="#A78BFA" stroke-opacity="0.5" />
                <rect x="34" y="24" width="34" height="46" fill="#45E6B5" fill-opacity="0.35" />
                <rect x="92" y="24" width="34" height="46" fill="#45E6B5" fill-opacity="0.35" />
              </svg>
            </div>
            <figcaption class="border-t border-ink/10 px-4 py-3">
              <p class="hud-label text-mint-400">Expected · lung region</p>
            </figcaption>
          </figure>

          <figure class="panel overflow-hidden border-amber-400/40">
            <div class="scanlines relative flex h-40 items-center justify-center bg-bg-base/60">
              <svg viewBox="0 0 160 90" class="h-32 w-auto" role="img" aria-label="Perhatian model di luar area paru">
                <rect x="6" y="4" width="148" height="82" fill="none" stroke="#F4F7FC" stroke-opacity="0.18" />
                <rect x="30" y="18" width="42" height="58" fill="none" stroke="#A78BFA" stroke-opacity="0.5" />
                <rect x="88" y="18" width="42" height="58" fill="none" stroke="#A78BFA" stroke-opacity="0.5" />
                <rect x="118" y="10" width="30" height="22" fill="#FBCB5D" fill-opacity="0.42" />
                <rect x="12" y="62" width="24" height="18" fill="#FBCB5D" fill-opacity="0.28" />
              </svg>
            </div>
            <figcaption class="border-t border-ink/10 px-4 py-3">
              <p class="hud-label text-amber-400">Observed · extra-pulmonary</p>
            </figcaption>
          </figure>
        </div>

        <p class="mt-3 flex items-start gap-3 border-l-2 border-amber-400/45 bg-amber-400/10 px-4 py-3 text-sm text-ink-2">
          <span class="text-amber-400" aria-hidden="true">&#9888;</span>
          <span>{findingWarning}</span>
        </p>
      </div>
    )
  }
</div>
