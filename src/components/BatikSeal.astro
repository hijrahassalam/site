---
// Kawung Convergence v1.1 seal (HIJRAH ASSALAM · SURAKARTA · INDONESIA), theme-aware.
// Cropped to the ring and given a paper disc so it can sit over the portrait.
import raw from '../brand/kc-seal.svg?raw';
import { themeSvg } from '../brand/theme-svg';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
const svg = themeSvg(raw, {
  className: `kc-seal ${className}`,
  viewBox: '50 50 220 220',
  prepend: '<circle cx="160" cy="160" r="109" class="kc-seal-bg"/>',
});
---

<Fragment set:html={svg} />
